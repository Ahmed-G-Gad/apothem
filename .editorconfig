# SPDX-License-Identifier: MIT

# EditorConfig for the Apothem source tree.
# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.py]
indent_style = space
indent_size = 4

# Canonical-contract sections (apothem editorconfig presence rule): the
# conformity validator `editorconfig-presence-grep` requires these literal
# section headers at these values; each override is declared once here.
[*.{yml,yaml,json}]
indent_size = 2

[*.md]
indent_size = 2
trim_trailing_whitespace = false

[*.toml]
indent_style = space
indent_size = 4

[*.{sh,bash}]
indent_style = space
indent_size = 2

# Windows scripts: CRLF, to agree with .gitattributes (`*.ps1/*.bat/*.cmd text eol=crlf`).
# PowerShell data and module files (.psd1, .psm1) stay LF under [*]. Keep this
# set in sync with .gitattributes and the mixed-line-ending exclude in
# .pre-commit-config.yaml.
[*.{ps1,bat,cmd}]
end_of_line = crlf

[Makefile]
indent_style = tab

[*.{png,jpg,jpeg,gif,ico,svg,woff,woff2,ttf,eot}]
insert_final_newline = false
trim_trailing_whitespace = false
