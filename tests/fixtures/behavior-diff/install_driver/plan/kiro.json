[
  {
    "mode": "merge_tree_entries",
    "source": "<APOTHEM_SRC>/rules",
    "target": "<HOME>/.config/apothem/rules"
  },
  {
    "mode": "native_skills",
    "source": "<APOTHEM_SRC>/skills",
    "target": "<HOME>/.kiro/skills"
  },
  {
    "mode": "command_skills",
    "source": "<APOTHEM_SRC>/commands",
    "target": "<HOME>/.kiro/skills"
  },
  {
    "mode": "merge_tree_entries",
    "source": "<APOTHEM_SRC>/templates",
    "target": "<HOME>/.config/apothem/templates"
  },
  {
    "mode": "sentinel_merge",
    "source": "<APOTHEM_SRC>/harnesses/kiro/templates/apothem-rules.md",
    "target": "<ROOT>/.kiro/steering/apothem-rules.md"
  },
  {
    "mode": "kiro_agents",
    "source": "<APOTHEM_SRC>/agents",
    "target": "<ROOT>/.kiro/agents"
  },
  {
    "mode": "merge_tree_entries",
    "source": "<APOTHEM_SRC>/hooks",
    "target": "<ROOT>/.apothem/support/kiro/hooks"
  },
  {
    "mode": "native_hooks",
    "source": "<APOTHEM_SRC>/harnesses/kiro/templates/apothem-hooks.json",
    "target": "<ROOT>/.kiro/hooks/apothem.json"
  }
]
