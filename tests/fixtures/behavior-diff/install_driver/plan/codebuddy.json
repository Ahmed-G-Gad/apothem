[
  {
    "mode": "merge_tree_entries",
    "source": "<APOTHEM_SRC>/rules",
    "target": "<HOME>/.config/apothem/rules"
  },
  {
    "mode": "native_skills",
    "source": "<APOTHEM_SRC>/skills",
    "target": "<HOME>/.codebuddy/skills"
  },
  {
    "mode": "command_skills",
    "source": "<APOTHEM_SRC>/commands",
    "target": "<HOME>/.codebuddy/skills"
  },
  {
    "mode": "merge_tree_entries",
    "source": "<APOTHEM_SRC>/templates",
    "target": "<HOME>/.config/apothem/templates"
  },
  {
    "mode": "sentinel_merge",
    "source": "<APOTHEM_SRC>/harnesses/codebuddy/templates/apothem-rules.md",
    "target": "<ROOT>/.codebuddy/rules/apothem-rules.md"
  },
  {
    "mode": "codebuddy_agents",
    "source": "<APOTHEM_SRC>/agents",
    "target": "<ROOT>/.codebuddy/agents"
  },
  {
    "mode": "merge_tree_entries",
    "source": "<APOTHEM_SRC>/hooks",
    "target": "<ROOT>/.apothem/support/hooks"
  },
  {
    "mode": "write_text",
    "source": "<APOTHEM_SRC>/harnesses/codebuddy/templates/settings-local.json",
    "target": "<ROOT>/.codebuddy/settings.local.json"
  }
]
