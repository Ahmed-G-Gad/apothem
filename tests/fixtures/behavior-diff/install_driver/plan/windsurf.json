[
  {
    "mode": "merge_tree_entries",
    "source": "<APOTHEM_SRC>/rules",
    "target": "<HOME>/.config/apothem/rules"
  },
  {
    "mode": "native_skills",
    "source": "<APOTHEM_SRC>/skills",
    "target": "<HOME>/.agents/skills"
  },
  {
    "mode": "command_skills",
    "source": "<APOTHEM_SRC>/commands",
    "target": "<HOME>/.agents/skills"
  },
  {
    "mode": "merge_tree_entries",
    "source": "<APOTHEM_SRC>/templates",
    "target": "<HOME>/.config/apothem/templates"
  },
  {
    "mode": "sentinel_merge",
    "source": "<APOTHEM_SRC>/harnesses/windsurf/templates/apothem-rules.md",
    "target": "<ROOT>/.devin/rules/apothem-rules.md"
  },
  {
    "mode": "devin_agents",
    "source": "<APOTHEM_SRC>/agents",
    "target": "<ROOT>/.devin/agents"
  },
  {
    "mode": "merge_tree_entries",
    "source": "<APOTHEM_SRC>/hooks",
    "target": "<ROOT>/.apothem/support/windsurf/hooks"
  },
  {
    "mode": "write_text",
    "source": "<APOTHEM_SRC>/harnesses/windsurf/templates/config-local.json",
    "target": "<ROOT>/.devin/config.local.json"
  }
]
