{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Bash(git log:*)"
    ],
    "deny": [
      "Read(.env*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(~/.ssh/**)",
      "Read(**/.audit/**)",
      "Read(**/__pycache__/**)",
      "Read(**/.mypy_cache/**)",
      "Read(**/.pytest_cache/**)",
      "Read(**/.ruff_cache/**)",
      "Read(**/.tox/**)",
      "Read(**/.venv/**)",
      "Read(**/node_modules/**)",
      "Read(**/dist/**)",
      "Read(**/build/**)",
      "Read(**/site/dist/**)",
      "Bash(rm -rf /:*)",
      "Bash(rm -rf /*:*)",
      "Bash(rm -rf ~:*)",
      "Bash(rm -rf ~/:*)",
      "Bash(sudo:*)",
      "Bash(git push --force:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(git push -f:*)",
      "Bash(eval:*)",
      "Bash(exec:*)",
      "PowerShell(git push --force:*)",
      "PowerShell(git push --force-with-lease:*)",
      "PowerShell(git push -f:*)",
      "PowerShell(Invoke-Expression:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "${PYTHON_BIN}",
            "timeout": 30,
            "statusMessage": "Initializing session posture",
            "args": [
              "<ROOT>/.apothem/support/hooks/dispatch.py",
              "SessionStart"
            ]
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "${PYTHON_BIN}",
            "timeout": 10,
            "statusMessage": "Checking the write target and content",
            "args": [
              "<ROOT>/.apothem/support/hooks/dispatch.py",
              "PreToolUse",
              "pretooluse-write",
              "pretooluse-write-header-guard",
              "pretooluse-write-plan-guard",
              "pretooluse-dependency-guard",
              "pretooluse-eval-guard"
            ]
          },
          {
            "type": "command",
            "command": "${PYTHON_BIN}",
            "timeout": 10,
            "statusMessage": "Running conformity checks on proposed content",
            "args": [
              "<ROOT>/.apothem/support/conformity/gate.py",
              "--hook"
            ]
          }
        ]
      },
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "${PYTHON_BIN}",
            "timeout": 10,
            "statusMessage": "Checking the edit target and content",
            "args": [
              "<ROOT>/.apothem/support/hooks/dispatch.py",
              "PreToolUse",
              "pretooluse-edit",
              "pretooluse-edit-header-guard",
              "pretooluse-write-plan-guard",
              "pretooluse-dependency-guard",
              "pretooluse-eval-guard"
            ]
          },
          {
            "type": "command",
            "command": "${PYTHON_BIN}",
            "timeout": 10,
            "statusMessage": "Running conformity checks on proposed content",
            "args": [
              "<ROOT>/.apothem/support/conformity/gate.py",
              "--hook"
            ]
          }
        ]
      },
      {
        "matcher": "NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "${PYTHON_BIN}",
            "timeout": 10,
            "statusMessage": "Checking the notebook cell and path",
            "args": [
              "<ROOT>/.apothem/support/hooks/dispatch.py",
              "PreToolUse",
              "pretooluse-notebookedit",
              "pretooluse-write-plan-guard"
            ]
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "${PYTHON_BIN}",
            "timeout": 10,
            "statusMessage": "Checking the shell command",
            "args": [
              "<ROOT>/.apothem/support/hooks/dispatch.py",
              "PreToolUse",
              "pretooluse-bash",
              "pretooluse-bash-plan-guard",
              "pretooluse-eval-guard"
            ]
          }
        ]
      },
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "${PYTHON_BIN}",
            "timeout": 10,
            "statusMessage": "Validating the (Recommended) option marker",
            "args": [
              "<ROOT>/.apothem/support/hooks/dispatch.py",
              "PreToolUse",
              "pretooluse-askuserquestion-recommended"
            ]
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "${PYTHON_BIN}",
            "timeout": 10,
            "statusMessage": "Tracking activity for proactive-compaction advisory",
            "args": [
              "<ROOT>/.apothem/support/hooks/dispatch.py",
              "PostToolUse",
              "posttooluse-proactive-compaction"
            ],
            "async": true
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "${PYTHON_BIN}",
            "timeout": 60,
            "statusMessage": "Finalizing session and externalizing state",
            "args": [
              "<ROOT>/.apothem/support/hooks/dispatch.py",
              "Stop",
              "stop"
            ]
          }
        ]
      }
    ]
  }
}
