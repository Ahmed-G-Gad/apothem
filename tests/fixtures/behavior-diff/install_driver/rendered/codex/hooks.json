{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"<ROOT>/hooks/dispatch.py\" SessionStart",
            "commandWindows": "\"${PYTHON_BIN}\" \"<ROOT>/hooks/dispatch.py\" SessionStart",
            "timeout": 30,
            "statusMessage": "Initializing session posture"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"<ROOT>/hooks/dispatch.py\" PreToolUse pretooluse-bash pretooluse-bash-plan-guard pretooluse-eval-guard",
            "commandWindows": "\"${PYTHON_BIN}\" \"<ROOT>/hooks/dispatch.py\" PreToolUse pretooluse-bash pretooluse-bash-plan-guard pretooluse-eval-guard",
            "timeout": 10,
            "statusMessage": "Checking the shell command"
          }
        ]
      },
      {
        "matcher": "Edit|Write|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"<ROOT>/hooks/dispatch.py\" PreToolUse pretooluse-write pretooluse-write-header-guard pretooluse-write-plan-guard pretooluse-dependency-guard pretooluse-eval-guard",
            "commandWindows": "\"${PYTHON_BIN}\" \"<ROOT>/hooks/dispatch.py\" PreToolUse pretooluse-write pretooluse-write-header-guard pretooluse-write-plan-guard pretooluse-dependency-guard pretooluse-eval-guard",
            "timeout": 10,
            "statusMessage": "Checking the write target and content"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "manual|auto",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"<ROOT>/hooks/dispatch.py\" PreCompact precompact",
            "commandWindows": "\"${PYTHON_BIN}\" \"<ROOT>/hooks/dispatch.py\" PreCompact precompact",
            "timeout": 30,
            "statusMessage": "Externalizing state before context compression"
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "matcher": "manual|auto",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"<ROOT>/hooks/dispatch.py\" PostCompact postcompact",
            "commandWindows": "\"${PYTHON_BIN}\" \"<ROOT>/hooks/dispatch.py\" PostCompact postcompact",
            "timeout": 30,
            "statusMessage": "Restoring state from durable files after compaction"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"<ROOT>/hooks/dispatch.py\" Stop stop",
            "commandWindows": "\"${PYTHON_BIN}\" \"<ROOT>/hooks/dispatch.py\" Stop stop",
            "timeout": 60,
            "statusMessage": "Finalizing session and externalizing state"
          }
        ]
      }
    ]
  }
}
